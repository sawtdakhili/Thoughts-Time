# Thoughts & Time - Self-Hosting Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================

# Port for the web application (default: 3000)
APP_PORT=3000

# Your domain or IP address (e.g., https://thoughts.example.com or http://localhost:3000)
SITE_URL=http://localhost:3000

# Additional allowed redirect URLs (comma-separated, optional)
ADDITIONAL_REDIRECT_URLS=

# ============================================
# Database Settings
# ============================================

# PostgreSQL password (REQUIRED - Change this!)
POSTGRES_PASSWORD=your-super-secret-postgres-password

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# ============================================
# Supabase Settings
# ============================================

# JWT Secret (REQUIRED - Generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# Supabase Anonymous Key (REQUIRED - See SELF_HOSTING.md for generation)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Supabase Service Role Key (REQUIRED - See SELF_HOSTING.md for generation)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjQxNzY5MjAwLCJleHAiOjE3OTk1MzU2MDB9.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Supabase URL (should match your site URL with :8000 port for Kong)
VITE_SUPABASE_URL=http://localhost:8000

# Supabase Anon Key for frontend (same as SUPABASE_ANON_KEY above)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Supabase Studio port (default: 3001)
STUDIO_PORT=3001

# Kong API Gateway ports
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ============================================
# Email Settings (Optional)
# ============================================

# Set to 'true' to skip email confirmation (for testing)
# WARNING: Only use in development/testing environments
MAILER_AUTOCONFIRM=false

# SMTP Configuration (required for email confirmation)
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Thoughts & Time

# ============================================
# Advanced Settings (Optional)
# ============================================

# Enable debug logging (true/false)
DEBUG=false

# Backup retention days (default: 30)
BACKUP_RETENTION_DAYS=30

# Backup directory (default: ./backups)
BACKUP_DIR=./backups
